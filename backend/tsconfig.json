{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"types": ["node"],
		"sourceMap": true,
		"baseUrl": "./src",
		"paths": {
			"@/*": ["*"],
			"@controllers/*": ["controllers/*"],
			"@routes/*": ["routes/*"],
			"@config/*": ["config/*"],
			"@lib/*": ["lib/*"],
			"@models/*": ["models/*"],
			"@services/*": ["services/*"],
			"@middlewares/*": ["middlewares/*"],
			"@sockets/*": ["sockets/*"],
			"@utils/*": ["utils/*"]
		}
	},
	"include": ["src", "tests"],
	"exclude": ["node_modules", "dist"]
}
